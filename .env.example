# ============================================================
# .env.example — NoteNest AI Platform
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already in .gitignore.
# For Railway/Render: add these as Environment Variables in the dashboard.
# ============================================================

# ── Environment ──────────────────────────────────────────────
APP_ENV=production
APP_URL=https://your-app.up.railway.app

# ── Database ─────────────────────────────────────────────────
DB_SERVER=db
DB_USERNAME=root
DB_PASSWORD=your_strong_password_here
DB_NAME=notenest
DB_PORT=3306
# ↑ Use 4000 for TiDB Cloud, 3306 for standard MySQL/Docker


# ── Groq AI API ──────────────────────────────────────────────
# Get your key from: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Gmail SMTP ───────────────────────────────────────────────
# Get app password: Google Account → Security → 2FA → App Passwords
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16char_app_password

# ── Google OAuth 2.0 (Classroom) ─────────────────────────────
# Get credentials: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret

# ── Jina AI Embeddings (optional — for vector search) ───────
# Get key: https://jina.ai/ (free tier available)
JINA_API_KEY=jina_your_key_here

# ── Qdrant Vector DB (optional — for vector search) ──────────
# Use Qdrant Cloud: https://cloud.qdrant.io/ (free 1GB cluster)
QDRANT_API_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
