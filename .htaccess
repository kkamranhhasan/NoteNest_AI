# ============================================================
# .htaccess — NoteNest AI Platform (InfinityFree Compatible)
# ============================================================

Options -Indexes

# ── Block access to sensitive files ──────────────────────────
<FilesMatch "(^debug_|\.sql$|\.json$|\.lock$|\.yml$|\.yaml$|\.env|\.git|\.md$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# ── Block access to sensitive directories ─────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block vendor & internal directories from web access
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^embeddings/ - [F,L]
    RewriteRule ^vector/ - [F,L]
    RewriteRule ^services/ - [F,L]
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^cron/ - [F,L]
    RewriteRule ^chroma_db/ - [F,L]
    RewriteRule ^phpmailer/ - [F,L]
    RewriteRule ^debug_ - [F,L]
</IfModule>

# ── Security Headers ──────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
