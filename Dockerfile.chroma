FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install ChromaDB
RUN pip install --no-cache-dir chromadb

# Copy service code
COPY chroma_service.py /app/

# Expose port 8000
EXPOSE 8000

# Run service
CMD ["python", "chroma_service.py", "8000"]
