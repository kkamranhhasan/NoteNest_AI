# ============================================================
# NoteNest — .gitignore
# ============================================================

# --- User uploaded files (don't push user data) ---
uploads/notes/*
uploads/recordings/*
!uploads/notes/.gitkeep
!uploads/recordings/.gitkeep

# --- Profile photos ---
img/user_photos/*
!img/user_photos/.gitkeep

# --- Config with sensitive info (NEVER push to GitHub) ---
config.php
config.local.php

# --- Environment / Secrets ---
.env
.env.local
# .env.example is safe to commit — it has no real secrets

# --- Docker local overrides (keep docker-compose.yml but ignore local override) ---
docker-compose.override.yml

# --- Local vector data ---
chroma_db/

# --- Python virtual environment ---
.venv/
__pycache__/
*.pyc
*.pyo

# --- PHP / Server ---
*.log
*.cache
.htpasswd

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- Temporary files ---
*.tmp
*.bak

# --- PHP sessions ---
/tmp/

# --- Database dumps (sensitive) ---
# database/*.sql   # Comment this out if you WANT to push the SQL file
