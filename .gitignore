# ============================================================
# NoteNest — .gitignore
# ============================================================

# --- User uploaded files (don't push user data) ---
uploads/notes/*
uploads/recordings/*
!uploads/notes/.gitkeep
!uploads/recordings/.gitkeep

# --- Profile photos ---
img/user_photos/*
!img/user_photos/.gitkeep

# --- Config with sensitive info (NEVER push to GitHub) ---
config.php
config.local.php

# --- Environment / Secrets ---
.env
.env.local
# .env.example is safe to commit — it has no real secrets

# --- Composer vendor (built automatically by Docker/Composer) ---
vendor/
phpmailer/

# --- Composer binary (not needed — Dockerfile installs it) ---
composer
composer.phar

# --- Docker local overrides ---
docker-compose.override.yml

# --- Python / ChromaDB (runtime data, not code) ---
chroma_db/
.venv/
__pycache__/
*.pyc
*.pyo

# --- Debug files (security risk — never deploy) ---
debug_gc.php
debug_sync_issue.php

# --- PHP / Server ---
*.log
*.cache
.htpasswd

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- Temporary files ---
*.tmp
*.bak
*_backup_temp.sql

# --- PHP sessions ---
/tmp/

# --- Database dumps (sensitive) ---
# database/*.sql   # Comment this out if you WANT to push the SQL file
